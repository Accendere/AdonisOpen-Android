<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="android.view.View"/>
        <variable name="callmodel" type="org.linhome.ui.call.CallViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style='@{"view_call_device_name"}'
        android:text='@{callmodel.callerName}'
        />

    <TextView
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        style='@{"view_call_device_address"}'
        android:text='@{callmodel.callerAddress}'
        android:visibility='@{callmodel.callerAddress != null &amp;&amp; !callmodel.callerAddress.empty ? View.VISIBLE : View.GONE}'
        />
    </LinearLayout>
</layout>
