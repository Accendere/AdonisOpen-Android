<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="org.linphone.core.Call.State" />
        <variable
            name="callmodel"
            type="org.linhome.ui.call.CallViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        gradientBackground='@{"dark_light_vertical_gradient"}'
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chunk_call_top"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true">

            <include
                layout="@layout/chunk_call_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chunk_call_name_address"
            app:layout_constraintTop_toBottomOf="@+id/chunk_call_top"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
            <include
                layout="@layout/chunk_call_name_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:callmodel="@{callmodel}" />
        </LinearLayout>

        <!-- The phone's main calls switch, as on the Doors toolbar: switch calls off (or back on) from a call. -->
        <org.linhome.ui.widgets.CallsSwitchPill
            android:id="@+id/calls_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/chunk_call_name_address"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <LinearLayout
            android:id="@+id/chunk_call_video_or_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/calls_switch"
            app:layout_constraintBottom_toTopOf="@+id/door_action_banner"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintDimensionRatio="H,4:3"
            app:layout_constraintWidth_percent="0.85">
            <include
                android:id="@+id/chunk_call_device_icon_or_video"
                layout="@layout/chunk_call_device_icon_or_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:callmodel="@{callmodel}"
                bind:incomingView="@{true}"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/door_action_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_door_action_banner"
            android:elevation="4dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/silent_timer_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <ProgressBar
                android:id="@+id/door_action_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminate="true" />

            <ImageView
                android:id="@+id/door_action_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/notification_door"
                android:visibility="gone" />

            <TextView
                android:id="@+id/door_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Opening door..." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/silent_timer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/pad"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <TextView
                android:id="@+id/silent_timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                style='@{"call_action_button"}'
                android:text="Video preview — auto-closing in 30s" />

            <ProgressBar
                android:id="@+id/silent_timer_progress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="240dp"
                android:layout_height="6dp"
                android:max="1000"
                android:progress="1000" />
        </LinearLayout>

        <!-- The door's first button large in the middle, the rest small (CallButtonPad). -->
        <org.linhome.ui.call.CallButtonPad
            android:id="@+id/pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <LinearLayout
            android:id="@+id/answered_elsewhere_card"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:elevation="12dp"
            android:visibility="gone"
            roundRectWithColor='@{"color_d"}'
            andRadius='@{"device_in_device_list_corner_radius"}'
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <!-- Sits where the answer/decline buttons were (they are hidden meanwhile), so the door's image stays visible. -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                tint='@{"color_a"}'
                src='@{"icons/phone"}' />

            <TextView
                android:id="@+id/answered_elsewhere_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                style='@{"view_sub_title"}'
                android:text="Call was answered on another device" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>