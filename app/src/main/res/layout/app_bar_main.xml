<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <data>
        <import type="android.view.View"/>
        <variable name="toolbarviewmodel1" type="org.linhome.ui.toolbar.ToolbarViewModel" />
        <variable name="tabbarviewmodel1" type="org.linhome.ui.tabbar.TabbarViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            android:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:contentInsetStart="0dp"
                android:contentInsetLeft="0dp"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/toolbar_back_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_linhome_icon"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:visibility='@{toolbarviewmodel1.visibility(toolbarviewmodel1.backButtonVisible)}'
                        android:layout_alignParentStart="true"
                        tint='@{"color_b"}'
                        src='@{"icons/back"}'/>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:minWidth="68dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_alignParentStart="true"
                        android:id="@+id/toolbar_left_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:orientation="horizontal"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility='@{toolbarviewmodel1.visibility(toolbarviewmodel1.leftButtonVisible)}'
                        >
                        <ImageView
                            android:id="@+id/toolbar_left_button_image"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerHorizontal="true"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_linhome_icon"
                            android:background="@color/transparent"
                            tint='@{"color_a"}'
                           />
                        <TextView
                            android:gravity="bottom|center_horizontal"
                            android:id="@+id/toolbar_left_button_title"
                            android:layout_width="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_below="@+id/toolbar_left_button_image"
                            style='@{"toolbar_action"}'
                            />
                    </RelativeLayout>

                    <TextView
                        android:gravity="center"
                        android:id="@+id/toolbar_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        style='@{"toolbar_title"}'
                        />


                    <RelativeLayout
                        android:layout_width="96dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:id="@+id/toolbar_right_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:orientation="horizontal"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility='@{toolbarviewmodel1.visibility(toolbarviewmodel1.rightButtonVisible)}'
                        android:layout_alignParentEnd="true"

                        >
                        <ImageView
                            android:id="@+id/toolbar_right_button_image"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_linhome_icon"
                            android:background="@color/transparent"
                            android:layout_centerHorizontal="true"
                            tint='@{"color_a"}'
                            />
                        <TextView
                            android:gravity="bottom"
                            android:id="@+id/toolbar_right_button_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_below="@+id/toolbar_right_button_image"
                            style='@{"toolbar_action"}'
                            />
                    </RelativeLayout>

                    <!-- Receive-calls toggle: a 48dp tap target drawing a 36dp pill in the theme's accent
                         (filled = taking calls, outlined = paused). Colors are set in MainActivity. -->
                    <LinearLayout
                        android:id="@+id/toolbar_calls_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="96dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/toolbar_calls_toggle_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="7dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_qs_receive_calls" />

                        <TextView
                            android:id="@+id/toolbar_calls_toggle_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Calls ON"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/transparent"
                        android:layout_alignParentBottom="true"
                        visibility="@{toolbarviewmodel1.activityInprogress ? View.VISIBLE : View.GONE }"
                        >
                        <androidx.core.widget.ContentLoadingProgressBar
                            android:id="@+id/progress"
                            android:background="@color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:indeterminate="true"
                            android:layout_marginTop="-21dp"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"
                        backgoundcolor='@{"color_h"}' />

                </RelativeLayout>

            </androidx.appcompat.widget.Toolbar>

            <!-- Shown when the site rejected this phone's webhook token (401): the person must scan
                 their setup link again. Colors and text are set in MainActivity. -->
            <TextView
                android:id="@+id/webhook_relink_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </com.google.android.material.appbar.AppBarLayout>

        <include layout="@layout/content_main"
            android:id="@+id/contentmain"
            bind:tabbarviewmodel2="@{tabbarviewmodel1}"
            />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
