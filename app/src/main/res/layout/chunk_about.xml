<?xml version="1.0" encoding="utf-8"?>
<!-- The About content (version, fork notice, links, license), shown in the Settings tab's About card. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="coreContext"
            type="org.linhome.linphonecore.CoreContext" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        gradientBackground='@{"dark_light_vertical_gradient"}'
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/linhome_icon"
            src='@{"others/adonis_open"}'
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/linhome_text"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerInside"
            src='@{"others/adonis_text"}' />

        <TextView
            android:id="@+id/linhome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            style='@{"splash_title"}'
            text='@{"splash_title"}' />

        <TextView
            android:id="@+id/appversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            text='@{"app_version"}'
            text_args='@{"Android,"+coreContext.appVersion}'
            style='@{"about_text"}' />

        <TextView
            android:id="@+id/linhome_base_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="center"
            text='@{"about_based_on"}'
            text_args='@{coreContext.linhomeBaseVersion}'
            style='@{"about_text"}' />

        <TextView
            android:id="@+id/sdkversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="center"
            text='@{"sdk_version"}'
            text_args='@{coreContext.sdkVersion}'
            style='@{"about_text"}' />

        <TextView
            android:id="@+id/fork_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAlignment="center"
            style='@{"about_text"}'
            text='@{"about_fork_notice"}' />

        <TextView
            android:id="@+id/source_code"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            style='@{"about_link"}'
            text='@{"about_source_link"}' />

        <TextView
            android:id="@+id/upstream_link"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            style='@{"about_link"}'
            text='@{"about_upstream_link"}' />

        <TextView
            android:id="@+id/licence"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            style='@{"about_link"}'
            text='@{"license_text"}' />

        <TextView
            android:id="@+id/copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            style='@{"about_text"}'
            text='@{"copyright_text"}' />

        <TextView
            android:id="@+id/disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="11sp"
            android:textAlignment="center"
            style='@{"about_text"}'
            text='@{"about_disclaimer"}' />

        <TextView
            android:id="@+id/privacy_policy"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            style='@{"about_link"}'
            text='@{"privacy_policy_text"}' />

    </LinearLayout>
</layout>
