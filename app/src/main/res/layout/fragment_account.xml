<?xml version="1.0" encoding="utf-8"?>
<!-- The Account screen (from the account card on the Doors tab): a summary, Edit account, getting new settings
     from the site, and Forget account at the bottom. Without an account it offers the setup choices. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View"/>

        <variable
            name="model"
            type="org.linhome.ui.account.AccountViewModel" />
    </data>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        backgoundcolor='@{"color_d"}'
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            tools:context=".ui.account.AccountFragment">

            <TextView
                android:id="@+id/identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                style='@{"account_info"}'
                android:text='@{model.identity}' />

            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style='@{"account_info"}'
                android:visibility="@{model.details != null ? View.VISIBLE : View.GONE}"
                android:text='@{model.details}' />

            <org.linhome.ui.widgets.LRoundRectButton
                android:id="@+id/edit_account"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="320dp"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                primary='@{true}'
                text='@{"account_edit"}'
                android:visibility="@{model.configured ? View.VISIBLE : View.GONE}"
                />

            <TextView
                android:id="@+id/new_settings_title"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                style='@{"section_title"}'
                text='@{"account_new_settings_title"}' />

            <org.linhome.ui.widgets.LRoundRectButton
                android:id="@+id/scan_setup_code"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="320dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                primary='@{false}'
                text='@{"scan_setup_code"}'
                />

            <org.linhome.ui.widgets.LRoundRectButton
                android:id="@+id/find_site"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="320dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                primary='@{false}'
                text='@{"assistant_find_site_lan"}'
                />

            <org.linhome.ui.widgets.LRoundRectButton
                android:id="@+id/setup_sip"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="320dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                primary='@{false}'
                text='@{"assistant_enter_sip_manually"}'
                android:visibility="@{model.configured ? View.GONE : View.VISIBLE}"
                />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <org.linhome.ui.widgets.LRoundRectButton
                android:id="@+id/forget_account"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="320dp"
                android:layout_height="48dp"
                text='@{"account_forget"}'
                android:visibility="@{model.configured ? View.VISIBLE : View.GONE}"
                />

        </LinearLayout>

    </ScrollView>
</layout>
