# Copy this file to "keystore.properties" (which is git-ignored) and fill in your
# own private upload key details to produce signed release builds.
# Paths are relative to the project root. NEVER commit the real file or keystore.
#
# Alternatively, set these environment variables instead of using this file:
#   ADONIS_KEYSTORE_FILE, ADONIS_KEYSTORE_PASSWORD, ADONIS_KEY_ALIAS, ADONIS_KEY_PASSWORD
storeFile=../adonis-upload.jks
storePassword=
keyAlias=adonis-upload
keyPassword=
